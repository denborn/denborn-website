# dependencies
/node_modules

# build output
/dist
*.tsbuildinfo

# Cloudflare local state and secrets
/.wrangler
.dev.vars*
.env*

# testing
/coverage
/test-results
/playwright-report
/blob-report

# artwork that is not ours: never committed (see CREDITS.md)
/tmp
/public/sprites

# generated at build time from the pinned sources
/src/data/generated

# misc
.DS_Store
*.pem
npm-debug.log*

# generated by `wrangler types`
/worker-configuration.d.ts

# third-party skills: reinstall from skills-lock.json
/.agents
/.claude/skills/design-taste-frontend

# sources downloaded at build time from their pinned versions (see data-sources/*.lock.json)
/.cache
