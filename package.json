{
  "name": "denborn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assets/sync-sprites.ts && node scripts/data/build-datapack.ts && wrangler types && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run test:e2e",
    "cf-typegen": "wrangler types",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "data": "node scripts/assets/sync-sprites.ts && node scripts/data/build-datapack.ts",
    "data:accept": "node scripts/data/build-datapack.ts --accept --report",
    "data:pin": "node scripts/data/fetch-sources.ts --pin && node scripts/assets/sync-sprites.ts --pin"
  },
  "dependencies": {
    "@fontsource/vt323": "5.3.0",
    "@pkmn/data": "0.10.12",
    "@pkmn/dex": "0.10.12",
    "@pkmn/sim": "0.10.12",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "storybook": "10.6.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1",
    "wrangler": "4.154.0"
  }
}
